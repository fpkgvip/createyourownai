# Uncomment only the variables you need in your local .env. Never commit real keys.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# RUNPOD_API_KEY=
# VAST_API_KEY=

# Optional overrides. The SSH path points to a private key, not its contents.
# CYOAI_LLM_PROVIDER=openai
# CYOAI_LLM_MODEL=
# CYOAI_LLM_BASE_URL=
# CYOAI_SSH_KEY=
